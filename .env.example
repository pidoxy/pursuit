# ── Required ───────────────────────────────────────────────────────
# Public URL of the app (OAuth redirect, links in emails)
APP_URL=https://pursuit.example.com
# 16+ random characters; encrypts Gmail tokens at rest. Keep it stable.
APP_SECRET=change-me-to-a-long-random-string
# Directory for the SQLite database (mount a volume here in production)
DATA_DIR=./data

# ── Gmail (read-only) ──────────────────────────────────────────────
# Google Cloud Console → enable Gmail API → OAuth consent screen (scope gmail.readonly,
# add yourself as a test user) → OAuth client (Web) with redirect URI <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# How far back the first sync reads, and the cap on messages fetched
BACKFILL_DAYS=180
BACKFILL_MAX=1500

# ── Optional: smarter extraction ───────────────────────────────────
# Without a key Pursuit uses its built-in rules (works well on standard hiring-platform mail).
ANTHROPIC_API_KEY=
# PURSUIT_MODEL=claude-opus-5-5

# ── Optional: forwarding address ───────────────────────────────────
# Point an inbound provider (e.g. Postmark) at <APP_URL>/api/inbound/postmark?secret=<INBOUND_SECRET>
INBOUND_DOMAIN=in.pursuit.example.com
INBOUND_SECRET=change-me-too

# ── Optional: morning brief email ──────────────────────────────────
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Pursuit <hello@pursuit.example.com>"
BRIEF_HOUR=7

# ── Scheduler ──────────────────────────────────────────────────────
# Gmail sync + briefs run in-process every 15 minutes. To drive them externally instead:
# DISABLE_SCHEDULER=true and POST /api/cron with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me-three
# DISABLE_SCHEDULER=true

# ── Public launch ──────────────────────────────────────────────────
# Shown on /privacy and /terms (required by Google's OAuth verification)
OPERATOR_NAME="Your name or company"
CONTACT_EMAIL=privacy@yourdomain.com
# Daily SQLite snapshots in DATA_DIR/backups (kept 7 days)
# BACKUP_KEEP_DAYS=7
# DISABLE_BACKUPS=true
